{
  "name": "@felipegalind0/jsbsim-wasm",
  "version": "1.2.4-fork.3",
  "description": "Tooling and TypeScript SDK for JSBSim compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Benedict Lewis",
    "email": "ben@bl.je"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./wasm/module": {
      "default": "./dist/wasm/jsbsim_wasm.mjs"
    },
    "./wasm/binary": {
      "default": "./dist/wasm/jsbsim_wasm.wasm"
    },
    "./build-metadata": "./dist/build-metadata.json"
  },
  "scripts": {
    "prepare:jsbsim": "node scripts/resolve-jsbsim-source.mjs",
    "generate:bindings": "node scripts/build.mjs",
    "build:wasm": "node scripts/build.mjs",
    "build:sdk": "node scripts/build.mjs",
    "test": "node scripts/run-built-check.mjs test",
    "bench:property-batch": "node scripts/run-built-check.mjs bench",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/run-built-check.mjs typecheck",
    "release:metadata": "node scripts/write-publish-metadata.mjs",
    "release": "node scripts/pack-build.mjs --release",
    "demo:install": "npm --prefix demo install",
    "demo:sync-wasm": "node scripts/sync-demo-wasm.mjs",
    "demo:sync-scenario": "node ./scripts/sync-demo-scenario.mjs",
    "demo:sync-assets": "npm run demo:sync-wasm && npm run demo:sync-scenario",
    "demo:prepare": "node scripts/sync-demo-wasm.mjs && npm run demo:sync-scenario",
    "demo:dev": "npm --prefix demo run dev",
    "demo:build": "npm --prefix demo run build",
    "demo:preview": "npm --prefix demo run preview",
    "clean": "node -e \"console.error('Build inputs and accepted artifacts are retained; remove only a reviewed failed attempt explicitly.'); process.exitCode=1\"",
    "build:metadata": "node scripts/write-build-metadata.mjs",
    "test:source": "node --test test/source-contract.test.mjs",
    "pack:build": "node scripts/pack-build.mjs",
    "prepack": "node -e \"throw new Error('Use npm run pack:build for an identified, checked immutable candidate.')\"",
    "build:dev": "node scripts/build.mjs --allow-dirty"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Felipegalind0/jsbsim.git",
    "directory": "wasm"
  }
}
